# Local Test Scripts & Artifacts
test_*.php
*.cjs
test_screenshots/
inspect_backup.php
storage/backups/

# Composer install di dalam subdirektori (test_extraction/ punya vendor sendiri).
# Perhatikan: /vendor di atas HANYA mengabaikan vendor/ di root repo.
vendor/

# Folder hasil ekstraksi uji (artefak lama, bukan bagian aplikasi).
# Mengandung vendor/ sendiri sehingga tidak boleh ikut ter-commit.
test_extraction/

# Duplikat framework/ dan logs/ yang muncul di root repo.
# Struktur yang benar sudah ada di storage/framework dan storage/logs,
# dan public/index.php memang hanya merujuk ke storage/framework.
# Lihat: public/index.php - __DIR__.'/../storage/framework/maintenance.php'
/framework/
/logs/

# Skrip catatan pribadi saat menelusuri data.
/scratch_users.php

# Skrip backup/pelarian manual di root. Dipakai sekali saat menelusuri data,
# tidak pernah dipanggil aplikasi (Laravel hanya autoload app/, config/,
# database/, routes/, bootstrap/). Tidak perlu ada di server.
/database_backup.php

# Salinan data produksi untuk tools/peta (location, assignment, operator name).
# Mengandung data operasional nyata, jadi tidak boleh ikut ter-commit.
# Kalau ini bocor, siapa pun yang punya repo bisa tahu lokasi tugas dan
# siapa yang bertugas.
/tools/peta/peta-data.js

# Cache API debug langsung (tools/peta/live.php), isinya posisi operator
# dari produksi. Tidak boleh ikut ter-commit.
/tools/peta/.live-cache.json

